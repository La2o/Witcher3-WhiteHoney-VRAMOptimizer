<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WhiteHoney</AssemblyName>
    <RootNamespace>WhiteHoney</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Off: a self-extracting compressed bundle looks like a packed executable to antivirus heuristics. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <Product>White Honey - VRAM Optimizer</Product>
    <Company>La2o</Company>
    <Description>Ranks The Witcher 3 texture and mesh mods by the VRAM and geometry they add.</Description>
  </PropertyGroup>
</Project>
